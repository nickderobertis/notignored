{
  "name": "pool-maintenance-journeys",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:host", "lang:bash"],
  "targets": {
    "bootstrap": { "command": "just _pool-maintenance-bootstrap" },
    "format": { "executor": "nx:noop" },
    "format-check": { "executor": "nx:noop" },
    "lint": {
      "command": "bash ../../scripts/dev-tool.sh shellcheck test.sh",
      "options": { "cwd": "pool-maintenance/journeys" },
      "inputs": ["default", "{workspaceRoot}/.shellcheck-version"]
    },
    "test": {
      "command": "bash test.sh",
      "options": { "cwd": "pool-maintenance/journeys" },
      "inputs": [
        "default",
        "{workspaceRoot}/pool-maintenance/measure.sh",
        "{workspaceRoot}/justfile"
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "test"]
    }
  }
}
