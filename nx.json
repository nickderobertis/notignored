{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/scripts/dev-tool.sh"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "pythonToolchain": [
      "{workspaceRoot}/.ruff-version",
      "{workspaceRoot}/.mypy-version",
      "{workspaceRoot}/scripts/setup-python-tools.sh"
    ],
    "crateSource": [
      "{workspaceRoot}/src/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock"
    ],
    "e2eRootInputs": [
      "crateSource",
      "sharedGlobals",
      "{workspaceRoot}/scripts/action/**/*",
      "{workspaceRoot}/scripts/comment-render/**/*",
      "{workspaceRoot}/scripts/ci-required.sh",
      "{workspaceRoot}/scripts/coverage.sh",
      "{workspaceRoot}/scripts/github-release.sh",
      "{workspaceRoot}/scripts/install.sh",
      "{workspaceRoot}/scripts/npm-build.mjs",
      "{workspaceRoot}/scripts/npm-install-probe.sh",
      "{workspaceRoot}/scripts/nx.sh",
      "{workspaceRoot}/scripts/nx-affected.sh",
      "{workspaceRoot}/scripts/pr-comment-body.sh",
      "{workspaceRoot}/scripts/preserved-log.sh",
      "{workspaceRoot}/scripts/publish-npm.sh",
      "{workspaceRoot}/scripts/retry-install.sh",
      "{workspaceRoot}/scripts/screenshots.sh",
      "{workspaceRoot}/scripts/setup-*.sh",
      "{workspaceRoot}/scripts/smoke-published.sh",
      "{workspaceRoot}/scripts/update-major-tag.sh",
      "{workspaceRoot}/action.yml",
      "{workspaceRoot}/npm/notignored/**/*",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/LICENSE",
      "{workspaceRoot}/examples/**/*",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/llmlint.yml",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/**/*",
      "{workspaceRoot}/.*-version",
      "{workspaceRoot}/**/project.json"
    ],
    "e2eSharedTests": [
      "{workspaceRoot}/tests/fixtures/**/*",
      "{workspaceRoot}/tests/golden/**/*"
    ],
    "jsToolchain": [
      "{workspaceRoot}/tests/js-toolchain/package.json",
      "{workspaceRoot}/tests/js-toolchain/package-lock.json",
      "{workspaceRoot}/scripts/setup-js.sh"
    ]
  },
  "targetDefaults": {
    "bootstrap": { "cache": false },
    "format": { "cache": false },
    "format-check": { "cache": true, "inputs": ["default"] },
    "lint": { "cache": true, "inputs": ["default"] },
    "test": { "cache": true, "inputs": ["default"] },
    "doc": { "cache": true, "inputs": ["default"] },
    "check": {
      "cache": false,
      "dependsOn": ["format-check", "lint", "test"]
    }
  }
}
