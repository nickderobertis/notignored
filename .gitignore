/target
/.dev
# The Nx orchestrator's own install and computation cache. `scripts/nx.sh`
# re-creates node_modules from the committed lockfile whenever it is missing.
/node_modules
/.nx
# Preserved command output (scripts/preserved-log.sh). Owner-only, truncated per
# run, and never a source: it is the evidence a captured run leaves behind.
/.logs
# Each project's own provisioned environment; every one is re-created from a
# committed lockfile by its `bootstrap` target.
.venv/
# Interpreter and runner scratch from the Python SDK's suite.
__pycache__/
.pytest_cache/
# Assembled by scripts/npm-build.mjs and maturin; the committed sources are
# npm/notignored/ and pyproject.toml.
/npm/dist
/dist
# Coverage instrumentation writes these wherever an instrumented binary happens
# to run, which for the e2e journeys is a fixture directory. They are raw counter
# dumps, never sources.
*.profraw
# Composed once during buildout and deliberately not committed (see AGENTS.md /
# the create-repo skill): the one-time llmlint structural tier.
llmlint.buildout.yml
REPO_PLAN.md
# Local sync bookkeeping for gh-secrets (per-machine; the manifest itself is tracked)
.gh-secrets-state.json
