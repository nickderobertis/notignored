{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/session-setup.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(just bootstrap)",
      "Bash(just check)",
      "Bash(just test)",
      "Bash(just test-e2e)",
      "Bash(just lint)",
      "Bash(just format)",
      "Bash(just fmt-check)",
      "Bash(just doc)",
      "Bash(just msrv)",
      "Bash(just upgrade)",
      "Bash(just deps-check)",
      "Bash(just run:*)",
      "Bash(just session-setup)",
      "Bash(just setup-llmlint)",
      "Bash(just lint-llm:*)",
      "Bash(just lint-llm-diff:*)",
      "Bash(just lint-llm-validate:*)",
      "Bash(llmlint doctor)",
      "Bash(llmlint history:*)",
      "Bash(llmlint --version)",
      "Bash(./scripts/session-setup.sh)",
      "Bash(./scripts/setup-llmlint.sh)",
      "Bash(./scripts/install.sh:*)",
      "Bash(cargo metadata --no-deps --format-version 1)",
      "Bash(cargo update --dry-run)",
      "Bash(rustup show:*)",
      "Bash(rustup component add:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(gh pr merge --auto --squash)",
      "Bash(gh pr status)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "deny": []
  }
}
