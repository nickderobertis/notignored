{
  "name": "notignored",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": ["scope:cli", "lang:rust"],
  "targets": {
    "bootstrap": { "command": "just _crate-bootstrap" },
    "format": { "command": "just _crate-format" },
    "format-check": { "command": "just _crate-fmt-check" },
    "lint": { "command": "just _crate-lint" },
    "test": {
      "command": "just _crate-test",
      "outputs": ["{workspaceRoot}/target/coverage-profiles/notignored"]
    },
    "doc": { "command": "just doc" },
    "coverage": {
      "command": "just _crate-coverage",
      "cache": false,
      "dependsOn": [
        "test",
        { "projects": ["notignored-integration", "notignored-e2e"], "target": "test" }
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["format-check", "lint", "test", "doc", "coverage"]
    }
  }
}
