{
  "name": "notignored-sdk",
  "version": "0.0.0-managed",
  "description": "Typed TypeScript SDK for notignored: every lint and type-check suppression in a source tree, as records.",
  "keywords": ["lint", "noqa", "suppression", "code-review", "sdk", "typescript"],
  "homepage": "https://github.com/nickderobertis/notignored",
  "bugs": "https://github.com/nickderobertis/notignored/issues",
  "license": "MIT",
  "author": "Nick DeRobertis",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickderobertis/notignored.git",
    "directory": "npm/notignored-sdk"
  }
}
